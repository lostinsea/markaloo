{
  "name": "folia",
  "version": "0.11.3",
  "productName": "Markaloo",
  "description": "Markaloo - a fast, offline markdown viewer with tabs, Mermaid diagrams and live reload",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "node scripts/vendor-libs.js",
    "vendor": "node scripts/vendor-libs.js",
    "notices": "node scripts/generate-notices.js",
    "build": "electron-builder --win portable --publish never",
    "build-installer": "electron-builder --win nsis --publish never",
    "build-all": "electron-builder --win --publish never",
    "build-linux": "electron-builder --linux --publish never",
    "build-linux-appimage": "electron-builder --linux AppImage --publish never",
    "build-linux-deb": "electron-builder --linux deb --publish never",
    "build-mac": "electron-builder --mac --publish never",
    "release": "node scripts/release.js",
    "test:actor-contracts": "node test/test-reload-transport-contract.js && node test/test-owned-transport-contract.js && node test/test-shutdown-response-contract.js && node test/test-deletion-delivery-contract.js && node test/test-default-tabs-contracts.js && node test/test-fixture-close-contracts.js && node test/test-default-save-contracts.js && node test/test-shutdown-lifecycle-source.js && node test/test-f22-fixture-contracts.js && node test/test-security-actor-contracts.js && node test/test-installed-update-contracts.js && node test/test-shutdown-deadline-source.js && node test/test-teardown-source.js && node test/test-mermaid-popup-contracts.js && node test/test-companion-accounting-contracts.js",
    "test:tabs": "npm run test:actor-contracts && node test/test-reload-transport-contract.js && node test/test-owned-transport-contract.js && electron test/test-tab-refresh.js",
    "test:reload-dialog": "node --check test/test-reload-dialog.js && electron test/test-reload-dialog.js",
    "test:dialogs": "node --check test/test-app-dialogs.js && electron test/test-app-dialogs.js",
    "test:owned-dialogs": "node --check test/test-owned-dialogs.js && electron test/test-owned-dialogs.js",
    "test:updates": "node test/test-update-state.js && node test/test-about-updates.js",
    "test:update-state": "node test/test-update-state.js",
    "test:updates-ui": "node test/test-about-updates.js --ui",
    "test:updates-portable": "node test/test-about-updates.js --portable",
    "start-dev": "NODE_ENV=development electron .",
    "test:security": "node test/test-security-actor-contracts.js && electron test/test-render-security.js",
    "test:popups": "node test/test-mermaid-popup-contracts.js && node --check src/main.js && node --check test/test-popup-security.js && electron test/test-popup-security.js",
    "test:packaging": "node test/test-packaging.js",
    "test:profile": "node test/test-dev-profile.js",
    "test:mermaid": "node test/test-mermaid-popup-contracts.js && electron test/test-mermaid-render.js",
    "test:visual": "electron test/test-visual-utils-selfcheck.js",
    "test:startup": "electron test/test-startup-perf.js",
    "test:document-session": "node test/test-document-session.js",
    "test:search": "electron test/test-search.js",
    "test:toc": "node --check test/test-toc.js && electron test/test-toc.js",
    "test:toc-toolbar": "node --check test/test-toc-toolbar.js && node test/test-toc-toolbar.js",
    "test:reading": "node --check test/test-reading.js && node test/test-reading.js",
    "test:reading-panels": "node --check test/test-reading.js && node test/test-reading.js --panels",
    "test:zoom": "node --check test/test-reading-zoom.js && node test/test-reading-zoom.js",
    "test:document-editor": "node --check test/test-document-editor.js && electron test/test-document-editor.js",
    "test:editor-scroll": "node --check src/editor-scroll.js && node --check test/test-editor-scroll.js && electron test/test-editor-scroll.js",
    "test:responsive": "node --check test/test-responsive-layout.js && electron test/test-responsive-layout.js",
    "test:patch": "electron test/test-render-patch.js",
    "test:corpus": "node --check bench/run.js && node --check bench/corpus.js && node bench/verify.js",
    "bench": "electron bench/run.js",
    "bench:f22": "node bench/run-f22-shutdown.js",
    "test:features": "npm run test:syntax && npm run test:updates && npm run test:toc-toolbar && npm run test:document-editor && npm run test:editor-scroll && npm run test:table-cells && npm run test:reading-panels",
    "test": "npm run test:actor-contracts && npm run test:packaging && npm run test:profile && npm run test:corpus && npm run test:startup && npm run test:document-session && npm run test:features && npm run test:tabs && npm run test:reload-dialog && npm run test:owned-dialogs && npm run test:dialogs && npm run test:security && npm run test:popups && npm run test:visual && npm run test:search && npm run test:toc && npm run test:reading && npm run test:zoom && npm run test:responsive && npm run test:mermaid && npm run test:patch && npm run test:tables && npm run test:theme",
    "test:tables": "node --check test/test-table-display.js && electron test/test-table-display.js",
    "test:table-cells": "npm run test:table-cells-source && npm run test:table-cells-ui",
    "test:table-cells-ui": "electron test/test-table-cell-editor.js --partition=input && electron test/test-table-cell-editor.js --partition=remaining",
    "test:table-cells-source": "node --check src/table-cell-editor.js && node --check test/test-table-cell-editor.js && node test/test-table-cell-editor.js --source",
    "test:theme": "node --check test/test-theme.js && electron test/test-theme.js",
    "test:syntax": "node --check test/test-language-highlighting.js && electron test/test-language-highlighting.js",
    "test:syntax-source": "node test/test-language-highlighting.js --source"
  },
  "keywords": [
    "markdown",
    "viewer",
    "electron",
    "mermaid",
    "markaloo"
  ],
  "author": {
    "name": "lostinsea"
  },
  "license": "MIT",
  "homepage": "https://github.com/lostinsea/markaloo#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/lostinsea/markaloo.git"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "dompurify": "^3.4.14",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "marked": "^18.0.10",
    "mermaid": "^11.17.0",
    "prismjs": "^1.30.0"
  },
  "dependencies": {
    "electron-updater": "^6.1.7",
    "semver": "^7.8.5"
  },
  "overrides": {
    "brace-expansion": "^5.0.9"
  },
  "build": {
    "appId": "io.github.lostinsea.folia",
    "productName": "Markaloo",
    "publish": [
      {
        "provider": "github",
        "owner": "lostinsea",
        "repo": "markaloo"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/index.html",
      "src/main.js",
      "src/main-preload.js",
      "src/app-dialogs.js",
      "src/app-updates.js",
      "src/update-state.js",
      "src/owned-dialogs.js",
      "src/owned-dialog.html",
      "src/owned-dialog-preload.js",
      "src/owned-dialog-renderer.js",
      "src/popup-theme.js",
      "src/document-events.js",
      "src/renderer.js",
      "src/reload-request.js",
      "src/editor-scroll.js",
      "src/inline-formatting.js",
      "src/table-cell-editor.js",
      "src/popup-preload.js",
      "src/styles.css",
      "assets/logo.ico",
      "assets/logo.png",
      "assets/logo_dark.png",
      "assets/app-icon.png",
      "assets/file-icon.png",
      "assets/file-icon.ico",
      "libs/**/*",
      "fonts/**/*",
      "src/utils.js",
      "src/mermaid-config.js",
      "src/context-menu-utils.js",
      "src/notification-helpers.js",
      "src/file-helpers-core.js",
      "src/file-helpers.js",
      "src/emoji-map.js",
      "src/emoji-parser.js",
      "node_modules/**/*",
      "!**/*.md",
      "!dist/**/*",
      "!release-artifacts/**/*",
      "!linux-builds/**/*",
      "!tmp/**/*",
      "!.github/**/*",
      "!.git/**/*",
      "src/custom-styles.css",
      "src/custom-tabs.js",
      "src/custom-performance.js",
      "src/custom-theme.js",
      "src/custom-collapse.js"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/logo.ico",
      "signtoolOptions": null,
      "fileAssociations": [
        {
          "ext": "md",
          "name": "Markdown Document",
          "description": "Markdown Document",
          "icon": "assets/file-icon.ico",
          "role": "Viewer"
        },
        {
          "ext": "mmd",
          "name": "Mermaid Diagram",
          "description": "Mermaid Diagram File",
          "icon": "assets/file-icon.ico",
          "role": "Viewer"
        },
        {
          "ext": "mermaid",
          "name": "Mermaid Diagram",
          "description": "Mermaid Diagram File",
          "icon": "assets/file-icon.ico",
          "role": "Viewer"
        }
      ],
      "artifactName": "Markaloo-${version}.${ext}"
    },
    "mac": {
      "artifactName": "Markaloo-${version}-${arch}.${ext}",
      "target": [
        "dmg"
      ],
      "icon": "assets/app-icon.png",
      "fileAssociations": [
        {
          "ext": "md",
          "name": "Markdown Document",
          "description": "Markdown Document",
          "role": "Viewer"
        },
        {
          "ext": "mmd",
          "name": "Mermaid Diagram",
          "description": "Mermaid Diagram File",
          "role": "Viewer"
        },
        {
          "ext": "mermaid",
          "name": "Mermaid Diagram",
          "description": "Mermaid Diagram File",
          "role": "Viewer"
        }
      ]
    },
    "linux": {
      "artifactName": "Markaloo-${version}-${arch}.${ext}",
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Utility",
      "maintainer": "lostinsea <lostinsea@users.noreply.github.com>",
      "icon": "assets/app-icon.png",
      "fileAssociations": [
        {
          "ext": "md",
          "name": "Markdown Document",
          "description": "Markdown Document",
          "mimeType": "text/markdown",
          "icon": "assets/file-icon.png"
        },
        {
          "ext": "mmd",
          "name": "Mermaid Diagram",
          "description": "Mermaid Diagram File",
          "mimeType": "text/x-mermaid",
          "icon": "assets/file-icon.png"
        },
        {
          "ext": "mermaid",
          "name": "Mermaid Diagram",
          "description": "Mermaid Diagram File",
          "mimeType": "text/x-mermaid",
          "icon": "assets/file-icon.png"
        }
      ]
    },
    "extraResources": [
      {
        "from": "README.md",
        "to": "README.md"
      },
      {
        "from": "THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      },
      {
        "from": "LICENSE.txt",
        "to": "LICENSE.txt"
      },
      {
        "from": "docs/images",
        "to": "docs/images"
      }
    ],
    "nsis": {
      "artifactName": "Markaloo-Setup-${version}.${ext}",
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "installerIcon": "assets/logo.ico",
      "uninstallerIcon": "assets/logo.ico",
      "installerHeaderIcon": "assets/logo.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Markaloo",
      "runAfterFinish": true,
      "menuCategory": true,
      "displayLanguageSelector": false,
      "installerLanguages": [
        "en_US"
      ],
      "language": "1033",
      "perMachine": true,
      "deleteAppDataOnUninstall": false,
      "license": "LICENSE.txt"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "allowScripts": {
    "electron-winstaller": false
  }
}
